/* 测试 9：逻辑运算符短路求值（第 9 章：phi 节点）*/
int g;
int bump(int x) {
    g = g + 1;
    return x;
}
int main() {
    int r;
    g = 0;
    if (0 && bump(1)) g = g + 100;   /* 左假 → 右边不求值, g 不变 */
    if (1 || bump(1)) g = g + 10;    /* 左真 → 右边不求值, g 只 +10 */
    r = bump(1) && 1;                /* 两侧都求值: g +1, r = 1 */
    return g * 10 + r;               /* 11*10 + 1 = 111 */
}
